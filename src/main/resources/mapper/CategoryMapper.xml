<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.articlesystem.mapper.CategoryMapper">

    <resultMap id="CategoryResultMap" type="org.example.articlesystem.entity.Category">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="categoryAlias" column="category_alias"/>
        <result property="description" column="description"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="status" column="status"/>
    </resultMap>

    <insert id="insertCategory" parameterType="org.example.articlesystem.entity.Category"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category (name, category_alias, description, create_user_id, status, create_time)
        VALUES (#{name}, #{categoryAlias}, #{description}, #{createUserId}, #{status}, NOW())
    </insert>

    <update id="deleteCategoryById" parameterType="int">
        UPDATE category SET status = 0 WHERE id = #{id}
    </update>

    <update id="updateCategory" parameterType="org.example.articlesystem.entity.Category">
        UPDATE category
        SET name = #{name}, category_alias = #{categoryAlias},
            description = #{description}, update_time = NOW()
        WHERE id = #{id}
    </update>

    <select id="selectCategoryById" parameterType="int" resultMap="CategoryResultMap">
        SELECT * FROM category WHERE id = #{id} AND status = 1
    </select>

    <select id="selectCategoryByAlias" parameterType="string" resultMap="CategoryResultMap">
        SELECT * FROM category WHERE category_alias = #{categoryAlias} AND status = 1
    </select>

    <sql id="selectCategoryWhere">
        WHERE status = 1
        <if test="keyword != null and keyword != ''">
            AND (name LIKE CONCAT('%', #{keyword}, '%')
            OR description LIKE CONCAT('%', #{keyword}, '%'))
        </if>
    </sql>

    <select id="selectCategoryList" parameterType="map" resultMap="CategoryResultMap">
        SELECT * FROM category
        <include refid="selectCategoryWhere"/>
        ORDER BY create_time DESC
        <if test="start != null and limit != null">
            LIMIT #{start}, #{limit}
        </if>
    </select>

    <select id="selectCategoryCount" parameterType="map" resultType="int">
        SELECT COUNT(*) FROM category
        <include refid="selectCategoryWhere"/>
    </select>

</mapper>