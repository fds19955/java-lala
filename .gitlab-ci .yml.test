stages:
  - test-aliyun
  - build-backend
  - build-frontend
  - push-images
  - k3s-deploy

variables:
  KUBE_NAMESPACE: "article-system"
  
  # 镜像仓库配置
  DOCKER_REGISTRY: "crpi-qaxlisuwj9fp5gv9.cn-beijing.personal.cr.aliyuncs.com"
  DOCKER_NAMESPACE: "fds-article"
  ALIYUN_REGISTRY_USER: "nick1191472774"
  ALIYUN_REGISTRY_PASSWORD: $ALIYUN_REGISTRY_PASSWORD
  
  # 数据库配置
  MYSQL_ROOT_PASSWORD: $DB_ROOT_PASSWORD
  MYSQL_DATABASE: "article_db"

test-aliyun:
  stage: test-aliyun
  image: docker:24.0.7
  script:
    - |
      echo "🔍 测试阿里云镜像仓库连接..."
      echo "$ALIYUN_REGISTRY_PASSWORD" | docker login -u "$ALIYUN_REGISTRY_USER" --password-stdin "$DOCKER_REGISTRY"
      echo "✅ 阿里云仓库连接成功"
  tags:
    - docker

build-backend:
  stage: build-backend
  image: maven:3.9.8-eclipse-temurin-17
  script:
    - |
      echo "🚀 开始构建后端应用..."
      mkdir -p ~/.m2
      cat > ~/.m2/settings.xml << 'EOF'
      <?xml version="1.0" encoding="UTF-8"?>
      <settings>
        <mirrors>
          <mirror>
            <id>alimaven</id>
            <name>aliyun maven</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>central</mirrorOf>
          </mirror>
        </mirrors>
      </settings>
      EOF
      
      cd backend
      mvn clean package -DskipTests
      echo "✅ 后端构建完成"
  artifacts:
    paths:
      - backend/target/*.jar
    expire_in: 1 hour
  tags:
    - docker

build-frontend:
  stage: build-frontend
  image: node:20-alpine
  script:
    - |
      echo "🎨 开始构建前端应用..."
      if [ ! -d "frontend" ]; then
        echo "⚠️ 前端目录不存在，跳过构建"
        exit 0
      fi
      
      cd frontend
      npm config set registry https://registry.npmmirror.com
      npm install --silent
      npm run build
      echo "✅ 前端构建完成"
  artifacts:
    paths:
      - frontend/dist/
    expire_in: 1 hour
  tags:
    - docker

push-images:
  stage: push-images
  image: docker:24.0.7
  needs:
    - build-backend
    - build-frontend
  before_script:
    - apk add --no-cache curl
  script:
    - |
      set -e
      echo "🚀 开始镜像推送流程..."
      echo "$ALIYUN_REGISTRY_PASSWORD" | docker login -u "$ALIYUN_REGISTRY_USER" --password-stdin "$DOCKER_REGISTRY"

      # 构建后端镜像
      echo "📦 构建后端镜像..."
      cat > Dockerfile.backend << EOF
      FROM eclipse-temurin:17-jre-alpine
      WORKDIR /app
      COPY backend/target/*.jar app.jar
      EXPOSE 8080
      ENTRYPOINT ["java", "-jar", "app.jar"]
      EOF

      BACKEND_IMAGE_TAG="${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/article-backend:${CI_COMMIT_SHORT_SHA}"
      docker build -f Dockerfile.backend -t "$BACKEND_IMAGE_TAG" .
      docker push "$BACKEND_IMAGE_TAG"
      echo "✅ 后端镜像推送完成: $BACKEND_IMAGE_TAG"

      # 构建前端镜像
      if [ -d "frontend/dist" ] && [ -n "$(ls -A frontend/dist)" ]; then
        echo "📦 构建前端镜像..."
        cat > frontend/Dockerfile.frontend << EOF
        FROM nginx:alpine
        COPY dist/ /usr/share/nginx/html
        COPY nginx.conf /etc/nginx/conf.d/default.conf
        EXPOSE 80
        EOF

        FRONTEND_IMAGE_TAG="${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/article-frontend:${CI_COMMIT_SHORT_SHA}"
        docker build -f frontend/Dockerfile.frontend -t "$FRONTEND_IMAGE_TAG" frontend/
        docker push "$FRONTEND_IMAGE_TAG"
        echo "✅ 前端镜像推送完成: $FRONTEND_IMAGE_TAG"
      fi
  tags:
    - docker

k3s-deploy:
  stage: k3s-deploy
  image: bitnami/kubectl:latest
  needs:
    - push-images
  before_script:
    - apk add --no-cache gettext
  script:
    - |
      set -e
      echo "🚀 开始K3s部署..."
      
      # 1. 创建命名空间
      kubectl apply -f k8s/namespace.yaml
      
      # 2. 处理模板变量
      mkdir -p k8s/generated
      
      # 处理secret.yaml
      export MYSQL_ROOT_PASSWORD="$DB_ROOT_PASSWORD"
      envsubst < k8s/secret.yaml > k8s/generated/secret.yaml
      
      # 3. 应用基础配置
      kubectl apply -f k8s/configmap.yaml
      kubectl apply -f k8s/generated/secret.yaml
      
      # 4. 部署MySQL主从
      echo "🐬 部署MySQL主从集群..."
      kubectl apply -f k8s/mysql-master.yaml
      kubectl apply -f k8s/mysql-slave.yaml
      
      # 5. 等待数据库就绪
      echo "⏳ 等待MySQL启动..."
      kubectl wait --for=condition=ready pod -l app=mysql,role=master -n $KUBE_NAMESPACE --timeout=300s
      
      # 6. 数据库初始化
      if [ -f "mysql/init/article_db.sql" ]; then
        echo "📦 初始化数据库..."
        kubectl run mysql-init --rm -i --restart='Never' --image=mysql:8.0 -n $KUBE_NAMESPACE -- \
          bash -c "cat /dev/stdin | mysql -h mysql-master.article-system.svc.cluster.local -uroot -p$MYSQL_ROOT_PASSWORD article_db" < mysql/init/article_db.sql
      fi
      
      # 7. 部署Redis
      kubectl apply -f k8s/redis.yaml
      
      # 8. 部署后端应用（替换镜像标签）
      cat k8s/backend-deployment.yaml | sed "s|\\\${DOCKER_REGISTRY}|${DOCKER_REGISTRY}|g" | sed "s|\\\${DOCKER_NAMESPACE}|${DOCKER_NAMESPACE}|g" | sed "s
