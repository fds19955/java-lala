{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    },
    // 以下是建议新增或修改的选项
    "skipLibCheck": true,        // 关键！跳过第三方库的类型检查，避免node_modules中的问题
    "moduleResolution": "bundler", // 关键！使用与Vite等现代打包器兼容的解析策略
    "allowSyntheticDefaultImports": true, // 解决部分默认导入报错
    "strict": false,               // **可选**：如果错误太多，可暂时关闭严格模式快速验证
    "types": ["vite/client"], // 添加 Vite 类型支持
    "baseUrl": ".", // 明确指定基础路径
    "assumeChangesOnlyAffectDirectDependencies": true // 优化增量编译
  }
}
