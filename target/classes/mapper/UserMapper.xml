<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.articlesystem.mapper.UserMapper">

    <resultMap id="UserResultMap" type="org.example.articlesystem.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="status" column="status"/>
    </resultMap>

    <insert id="insertUser" parameterType="org.example.articlesystem.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, email, avatar_url, status, create_time)
        VALUES (#{username}, #{password}, #{email}, #{avatarUrl}, #{status}, NOW())
    </insert>

    <update id="deleteUserById" parameterType="int">
        UPDATE user SET status = 0 WHERE id = #{id}
    </update>

    <update id="updateUser" parameterType="org.example.articlesystem.entity.User">
        UPDATE user
        SET username = #{username}, password = #{password},
            email = #{email}, avatar_url = #{avatarUrl}, update_time = NOW()
        WHERE id = #{id}
    </update>

    <select id="selectUserById" parameterType="int" resultMap="UserResultMap">
        SELECT * FROM user WHERE id = #{id} AND status = 1
    </select>

    <select id="selectUserByUsername" parameterType="string" resultMap="UserResultMap">
        SELECT * FROM user WHERE username = #{username} AND status = 1
    </select>

    <sql id="selectUserWhere">
        WHERE status = 1
        <if test="keyword != null and keyword != ''">
            AND (username LIKE CONCAT('%', #{keyword}, '%')
            OR email LIKE CONCAT('%', #{keyword}, '%'))
        </if>
    </sql>

    <select id="selectUserList" parameterType="map" resultMap="UserResultMap">
        SELECT * FROM user
        <include refid="selectUserWhere"/>
        ORDER BY create_time DESC
        <if test="start != null and limit != null">
            LIMIT #{start}, #{limit}
        </if>
    </select>

    <select id="selectUserCount" parameterType="map" resultType="int">
        SELECT COUNT(*) FROM user
        <include refid="selectUserWhere"/>
    </select>

</mapper>